# OTDEL — example environment variables (placeholders only, no real values)
#
# Status: no application runtime exists yet in this repository (design/prototype
# stage only). Nothing here is consumed by any script today. This file documents
# the variable names expected once the Rust backend (phase 1A, see
# docs/block-01-spec.md) is scaffolded, so contributors are not surprised later.
#
# Do NOT put real secrets, tokens, or connection strings in this file.
# Copy it to `.env` for local use once a runtime actually reads it; `.env` is
# git-ignored and must never be committed.

# --- PostgreSQL (planned, phase 1A) ---
# Local PostgreSQL instance with the pgvector extension enabled.
DATABASE_URL=postgres://otdel:changeme@localhost:5432/otdel_dev

# --- Object storage for original files (planned, phase 1A) ---
# S3-compatible endpoint for originals, page snapshots and OCR outputs.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=otdel-dev
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme

# --- Application server (planned, phase 1A) ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080

# --- AI model adapter (planned, later phase) ---
# Provider and credentials are not required for today's design/prototype work.
# Left unset intentionally until an adapter and provider are chosen.
# AI_MODEL_PROVIDER=
# AI_MODEL_API_KEY=

# --- External research adapter (planned, later phase) ---
# SEARCH_PROVIDER_API_KEY=
