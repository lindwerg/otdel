# OTDEL — environment variables of the phase 1A backend (placeholders only).
#
# Do NOT put real secrets here. The local pilot does not use this file at runtime:
# `scripts/dev-init.sh` generates `.local/otdel.env` with random credentials, and that
# directory is git-ignored. This file documents the variable names and defaults.
#
# The server refuses to start when a secret is empty or still looks like an example
# value (see crates/otdel-core/src/config.rs), so copying this file as-is will not
# silently run with a known password.

# --- runtime mode ---------------------------------------------------------------
# local | production. `production` additionally requires OTDEL_COOKIE_SECURE=true.
OTDEL_ENV=local
OTDEL_BIND_ADDR=127.0.0.1:18480

# --- PostgreSQL ------------------------------------------------------------------
# Runtime role: restricted, NOT the owner of the tables, NOBYPASSRLS. The API verifies
# at startup that row-level security really applies to this role and refuses otherwise.
OTDEL_DATABASE_URL=postgres://otdel_app:changeme@127.0.0.1:58432/otdel
# Migration role: owns the schema. Used only by `otdel-api migrate` / `bootstrap`.
OTDEL_DATABASE_ADMIN_URL=postgres://otdel_migrator:changeme@127.0.0.1:58432/otdel
OTDEL_DATABASE_MAX_CONNECTIONS=8

# --- workspace and owner ----------------------------------------------------------
# One local bureau, one owner, no open registration.
OTDEL_BUREAU_SLUG=local
# Argon2 PHC hash, produced by: printf '%s' "$PASSWORD" | otdel-api hash-password
OTDEL_OWNER_PASSWORD_HASH=

# --- originals --------------------------------------------------------------------
# Directory of the object store. Never served as a static directory: originals are only
# reachable through the authenticated download endpoint.
OTDEL_STORAGE_ROOT=.local/storage
OTDEL_MAX_UPLOAD_BYTES=26214400

# --- frontend origin (CORS with credentials; `*` is rejected) ----------------------
OTDEL_CORS_ALLOWED_ORIGINS=http://127.0.0.1:15173,http://localhost:15173

# --- sessions ----------------------------------------------------------------------
# Both values must be at least 60 seconds (the database session functions reject less)
# and the TTL at most 604800; the idle timeout may not exceed the TTL. Startup fails on
# a value outside that range instead of failing later on every request.
OTDEL_SESSION_TTL_SECONDS=43200
OTDEL_SESSION_IDLE_TIMEOUT_SECONDS=7200
OTDEL_SESSION_COOKIE_NAME=otdel_session
# Must be true outside the plain-HTTP local pilot.
OTDEL_COOKIE_SECURE=false

# --- login throttling ---------------------------------------------------------------
OTDEL_LOGIN_MAX_FAILURES=10
OTDEL_LOGIN_FAILURE_WINDOW_SECONDS=900
OTDEL_LOGIN_LOCKOUT_SECONDS=900

# --- document extraction, phase 1B ----------------------------------------------------
# How the worker reads documents. The text layer is read in process (pure Rust), so
# nothing below is needed for a PDF that has one.
#
# The page budget is a resource limit: a document with more pages is refused with a
# stated reason rather than read partially and called done. The page timeout must stay
# below the lease, otherwise a page that uses its whole budget loses the job to another
# worker while it is still running (startup refuses that combination).
OTDEL_WORKER_POLL_INTERVAL_SECONDS=2
OTDEL_WORKER_LEASE_SECONDS=120
OTDEL_EXTRACT_PAGE_TIMEOUT_SECONDS=60
OTDEL_EXTRACT_MAX_PAGES=500
# Scratch directory for page renders. Empty = the system temporary directory. The files
# are deleted after each job and are never published: phase 1B stores no page images.
OTDEL_EXTRACT_WORKDIR=

# --- recognition (OCR) ------------------------------------------------------------------
# OTDEL does not implement OCR; it drives local binaries through adapters and reports
# their absence. With `false`, or with the binaries missing, pages that have no usable
# text layer are recorded as `needs_ocr` **with the reason** — never as read, never as
# empty, and never with invented text. `otdel-worker probe` prints what is available.
#
# Install on macOS:  brew install tesseract tesseract-lang poppler
# Install on Debian: apt install tesseract-ocr tesseract-ocr-rus poppler-utils
OTDEL_OCR_ENABLED=true
# Bare name (resolved through PATH) or an absolute path. A relative path is refused.
OTDEL_OCR_ENGINE_BIN=tesseract
OTDEL_OCR_RENDERER_BIN=pdftoppm
# Language packs, joined with `+`. The availability probe checks they are installed.
OTDEL_OCR_LANGUAGES=rus+eng
OTDEL_OCR_DPI=220
OTDEL_OCR_TIMEOUT_SECONDS=120
OTDEL_OCR_MAX_PAGES_PER_RUN=200

# --- the product role's model adapter, phase 1C -----------------------------------------
# The single model adapter (spec §3). Until a key is supplied the product role reports
# "нужен ключ" and **no request is made**: the adapter built from an incomplete
# configuration has no HTTP client at all, so there is no path from the worker to the
# network, and a run is recorded as `needs_provider` without storing anything.
#
# `otdel-worker probe` prints the state. Never commit a real key: the local pilot keeps
# it in .local/otdel.env, which is git-ignored.
#
# openrouter | openai_compatible | disabled
OTDEL_LLM_PROVIDER=openrouter
# https:// only, except a loopback address (a self-hosted model). No credentials, no
# query string: the key travels in the Authorization header.
OTDEL_LLM_BASE_URL=https://openrouter.ai/api/v1
# Model identifier, e.g. openai/gpt-4o-mini. Required — nothing is guessed.
OTDEL_LLM_MODEL=
# Secret. Empty or an obvious placeholder counts as "not supplied".
OTDEL_LLM_API_KEY=

# Bounds applied to every call, before it is made (spec §10).
OTDEL_LLM_MAX_INPUT_CHARS=24000
OTDEL_LLM_MAX_PAGES_PER_REQUEST=6
OTDEL_LLM_MAX_REQUESTS_PER_RUN=8
OTDEL_LLM_MAX_OUTPUT_TOKENS=4000
OTDEL_LLM_MAX_RESPONSE_BYTES=1048576
OTDEL_LLM_TIMEOUT_SECONDS=120
OTDEL_LLM_MIN_REQUEST_INTERVAL_MS=250

# --- logging -------------------------------------------------------------------------
# Secrets and passwords are never logged; SQL statement logging is disabled.
OTDEL_LOG=info,otdel_api=info,otdel_worker=info,sqlx=warn

# --- integration tests (see docs/backend-1a.md) --------------------------------------
# OTDEL_TEST_DATABASE_URL=
# OTDEL_TEST_ADMIN_DATABASE_URL=
# OTDEL_TEST_SUPERUSER_URL=

# --- later phases ---------------------------------------------------------------------
# Search, budgets and S3 credentials belong to 1D/1E and are introduced together with
# the adapter that needs them, not before. The model key above is the only external
# credential this phase can use, and the system works — read materials, page evidence —
# without it.
