# OTDEL — environment variables of the phase 1A backend (placeholders only).
#
# Do NOT put real secrets here. The local pilot does not use this file at runtime:
# `scripts/dev-init.sh` generates `.local/otdel.env` with random credentials, and that
# directory is git-ignored. This file documents the variable names and defaults.
#
# The server refuses to start when a secret is empty or still looks like an example
# value (see crates/otdel-core/src/config.rs), so copying this file as-is will not
# silently run with a known password.

# --- runtime mode ---------------------------------------------------------------
# local | production. `production` additionally requires OTDEL_COOKIE_SECURE=true.
OTDEL_ENV=local
OTDEL_BIND_ADDR=127.0.0.1:18480

# --- PostgreSQL ------------------------------------------------------------------
# Runtime role: restricted, NOT the owner of the tables, NOBYPASSRLS. The API verifies
# at startup that row-level security really applies to this role and refuses otherwise.
OTDEL_DATABASE_URL=postgres://otdel_app:changeme@127.0.0.1:58432/otdel
# Migration role: owns the schema. Used only by `otdel-api migrate` / `bootstrap`.
OTDEL_DATABASE_ADMIN_URL=postgres://otdel_migrator:changeme@127.0.0.1:58432/otdel
OTDEL_DATABASE_MAX_CONNECTIONS=8

# --- workspace and owner ----------------------------------------------------------
# One local bureau, one owner, no open registration.
OTDEL_BUREAU_SLUG=local
# Argon2 PHC hash, produced by: printf '%s' "$PASSWORD" | otdel-api hash-password
OTDEL_OWNER_PASSWORD_HASH=

# --- originals --------------------------------------------------------------------
# Directory of the object store. Never served as a static directory: originals are only
# reachable through the authenticated download endpoint.
OTDEL_STORAGE_ROOT=.local/storage
OTDEL_MAX_UPLOAD_BYTES=26214400

# --- frontend origin (CORS with credentials; `*` is rejected) ----------------------
OTDEL_CORS_ALLOWED_ORIGINS=http://127.0.0.1:15173,http://localhost:15173

# --- sessions ----------------------------------------------------------------------
# Both values must be at least 60 seconds (the database session functions reject less)
# and the TTL at most 604800; the idle timeout may not exceed the TTL. Startup fails on
# a value outside that range instead of failing later on every request.
OTDEL_SESSION_TTL_SECONDS=43200
OTDEL_SESSION_IDLE_TIMEOUT_SECONDS=7200
OTDEL_SESSION_COOKIE_NAME=otdel_session
# Must be true outside the plain-HTTP local pilot.
OTDEL_COOKIE_SECURE=false

# --- login throttling ---------------------------------------------------------------
OTDEL_LOGIN_MAX_FAILURES=10
OTDEL_LOGIN_FAILURE_WINDOW_SECONDS=900
OTDEL_LOGIN_LOCKOUT_SECONDS=900

# --- document extraction, phase 1B ----------------------------------------------------
# How the worker reads documents. The text layer is read in process (pure Rust), so
# nothing below is needed for a PDF that has one.
#
# The page budget is a resource limit: a document with more pages is refused with a
# stated reason rather than read partially and called done. The page timeout must stay
# below the lease, otherwise a page that uses its whole budget loses the job to another
# worker while it is still running (startup refuses that combination).
OTDEL_WORKER_POLL_INTERVAL_SECONDS=2
OTDEL_WORKER_LEASE_SECONDS=120
OTDEL_EXTRACT_PAGE_TIMEOUT_SECONDS=60
OTDEL_EXTRACT_MAX_PAGES=500
# Scratch directory for page renders. Empty = the system temporary directory. The files
# are deleted after each job and are never published: phase 1B stores no page images.
OTDEL_EXTRACT_WORKDIR=

# --- recognition (OCR) ------------------------------------------------------------------
# OTDEL does not implement OCR; it drives local binaries through adapters and reports
# their absence. With `false`, or with the binaries missing, pages that have no usable
# text layer are recorded as `needs_ocr` **with the reason** — never as read, never as
# empty, and never with invented text. `otdel-worker probe` prints what is available.
#
# Install on macOS:  brew install tesseract tesseract-lang poppler
# Install on Debian: apt install tesseract-ocr tesseract-ocr-rus poppler-utils
OTDEL_OCR_ENABLED=true
# Bare name (resolved through PATH) or an absolute path. A relative path is refused.
OTDEL_OCR_ENGINE_BIN=tesseract
OTDEL_OCR_RENDERER_BIN=pdftoppm
# Language packs, joined with `+`. The availability probe checks they are installed.
OTDEL_OCR_LANGUAGES=rus+eng
OTDEL_OCR_DPI=220
OTDEL_OCR_TIMEOUT_SECONDS=120
OTDEL_OCR_MAX_PAGES_PER_RUN=200

# --- the product role's model adapter, phase 1C -----------------------------------------
# The single model adapter (spec §3). Until a key is supplied the product role reports
# "нужен ключ" and **no request is made**: the adapter built from an incomplete
# configuration has no HTTP client at all, so there is no path from the worker to the
# network, and a run is recorded as `needs_provider` without storing anything.
#
# `otdel-worker probe` prints the state. Never commit a real key: the local pilot keeps
# it in .local/otdel.env, which is git-ignored.
#
# openrouter | openai_compatible | disabled
OTDEL_LLM_PROVIDER=openrouter
# https:// only, except a loopback address (a self-hosted model). No credentials, no
# query string: the key travels in the Authorization header.
OTDEL_LLM_BASE_URL=https://openrouter.ai/api/v1
# Model identifier, e.g. openai/gpt-4o-mini. Required — nothing is guessed.
OTDEL_LLM_MODEL=
# Secret. Empty or an obvious placeholder counts as "not supplied".
OTDEL_LLM_API_KEY=

# Bounds applied to every call, before it is made (spec §10).
OTDEL_LLM_MAX_INPUT_CHARS=24000
OTDEL_LLM_MAX_PAGES_PER_REQUEST=6
OTDEL_LLM_MAX_REQUESTS_PER_RUN=8
OTDEL_LLM_MAX_OUTPUT_TOKENS=4000
OTDEL_LLM_MAX_RESPONSE_BYTES=1048576
OTDEL_LLM_TIMEOUT_SECONDS=120
OTDEL_LLM_MIN_REQUEST_INTERVAL_MS=250

# --- bounded industry research, phase 1D ------------------------------------------------
# The one part of OTDEL that reaches outside this machine, and the one that spends money.
# Until all three of SEARCH_URL, API_KEY and ALLOWED_HOSTS are set, **nothing leaves the
# machine and no budget is reserved**: the adapters built from an incomplete configuration
# have no HTTP client at all, an approved question is recorded as `needs_provider`, and
# reading and understanding materials keep working exactly as before.
#
# `otdel-worker probe` prints the state. Never commit a real key: the local pilot keeps it
# in .local/otdel.env, which is git-ignored.
#
# http_json | disabled
OTDEL_RESEARCH_PROVIDER=http_json

# The search endpoint. No provider has been chosen for OTDEL (spec §3 lists Perplexity and
# OpenRouter as *possible* adapters, not obligations), so this is a shape rather than a
# vendor: any endpoint that accepts
#     POST {"query": "...", "max_results": 8}
# and answers
#     {"results": [{"url": "https://…", "title": "…", "snippet": "…"}]}
# (`items` or `web.results` are also accepted). A vendor API, a self-hosted SearxNG, or a
# few lines of proxy in front of either.
#
# https:// only, except a loopback address (a self-hosted engine). No credentials, no query
# string: the key travels in a header.
OTDEL_RESEARCH_SEARCH_URL=
# Secret. Empty or an obvious placeholder counts as "not supplied".
OTDEL_RESEARCH_API_KEY=
# Header the key travels in. Empty means `Authorization: Bearer <key>`; some vendors want
# their own name, e.g. X-Subscription-Token.
OTDEL_RESEARCH_API_KEY_HEADER=

# **Required.** The publishers this system may read, comma-separated. `example.com` is that
# host exactly; `.example.com` also covers its subdomains. A search result whose host is not
# on this list is recorded as discovered-and-not-read, with the reason — there is no
# configuration in which "fetch whatever the search engine returned" is possible.
#
# Example for Russian standards work:
#   OTDEL_RESEARCH_ALLOWED_HOSTS=docs.cntd.ru,.gost.ru,.rosstandart.gov.ru
OTDEL_RESEARCH_ALLOWED_HOSTS=

# Bounds applied to one research plan, before any request is made (spec §6.5).
OTDEL_RESEARCH_MAX_QUERIES_PER_PLAN=3
OTDEL_RESEARCH_MAX_RESULTS_PER_QUERY=8
OTDEL_RESEARCH_MAX_SOURCES_PER_PLAN=6
OTDEL_RESEARCH_MAX_PAGE_BYTES=2097152
OTDEL_RESEARCH_MAX_PAGE_CHARS=40000
OTDEL_RESEARCH_REQUEST_TIMEOUT_SECONDS=20
OTDEL_RESEARCH_PLAN_TIME_BUDGET_SECONDS=300
OTDEL_RESEARCH_MIN_REQUEST_INTERVAL_MS=500
# How many times one question may be researched at all — the "предел проходов" of the plan.
OTDEL_RESEARCH_MAX_PASSES_PER_PLAN=2

# Money, in millionths of one currency unit (integers everywhere; nothing is ever converted
# between currencies). These are the **declared tariff** from your contract with the search
# provider, not an invoice: they are used to reserve budget before a call and to settle it
# after, so concurrent plans cannot both pass the same ceiling. The interface says so
# wherever it shows an amount.
OTDEL_RESEARCH_CURRENCY=USD
# 5000 = 0,005 USD per search. Replace with your real price.
OTDEL_RESEARCH_COST_PER_SEARCH_MICROS=5000
# Reading a public page costs the provider nothing; what bounds fetching is
# MAX_SOURCES_PER_PLAN, not money.
OTDEL_RESEARCH_COST_PER_FETCH_MICROS=0
# Interpreting the collected sources is a model call, and a model call is a paid call: it
# is reserved and settled through the same ledger as a search. A run over several sources
# makes several requests. 3000 = 0,003 USD per request — replace with the price your
# OTDEL_LLM_MODEL actually costs at your typical prompt size.
OTDEL_RESEARCH_COST_PER_MODEL_CALL_MICROS=3000
# Ceiling for the whole bureau, across every plan and every worker.
OTDEL_RESEARCH_BUDGET_MICROS=5000000
# Ceiling for one plan. Must not exceed the bureau's.
OTDEL_RESEARCH_PLAN_BUDGET_MICROS=100000

# --- verification, publication and search, phase 1E ---------------------------------------
# Read this section knowing one thing first: **none of it is required.** Checking
# candidates against their sources, deciding readiness and publishing an immutable version
# are deterministic — they use no model and no network, and they work with every variable
# below unset. What is configured here are two optional halves:
#
#   * the semantic half of search (embeddings), and
#   * the answer written in free-form prose.
#
# Without them, search runs on exact values and full text and reports `keyword` mode with
# the reason, and a question comes back with the found statements and their citations but
# no prose. Nothing is invented in either case: with no embedding provider **no vector is
# produced at all**, and a hashed or random stand-in is never substituted.
#
# Semantic search additionally needs the `pgvector` extension, which the restricted
# migration role may not create (the extension is not `trusted`). Run
# `make db-extensions` once — it installs it into the `otdel` schema, where the runtime
# role can reach it, and adds the vector column. Until then the API reports
# `vector.state = "extension_missing"` and search stays keyword-only.

# `openai_compatible` (default) or `disabled`.
OTDEL_EMBEDDING_PROVIDER=openai_compatible
# Any service exposing the OpenAI-compatible POST /embeddings endpoint, including
# OpenRouter and a locally hosted model. Plain http:// is accepted only for loopback.
OTDEL_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Empty means "not configured": no request is made and no vector is stored.
OTDEL_EMBEDDING_MODEL=
OTDEL_EMBEDDING_API_KEY=
# Bounds on every embedding call, applied before it is made.
OTDEL_EMBEDDING_BATCH_SIZE=32
OTDEL_EMBEDDING_MAX_INPUT_CHARS=4000
OTDEL_EMBEDDING_MAX_RESPONSE_BYTES=16777216
OTDEL_EMBEDDING_TIMEOUT_SECONDS=120
OTDEL_EMBEDDING_MIN_REQUEST_INTERVAL_MS=250

# Bounds on reading the published version. A query longer than the limit is refused
# rather than clipped: answering a shortened question without saying so would be
# answering a different question.
OTDEL_RETRIEVAL_MAX_QUERY_CHARS=500
OTDEL_RETRIEVAL_MAX_RESULTS=20
# How many statements are put in front of the answering model. This is the bounded
# context of block-01-spec.md §9 — the model sees these and nothing else.
OTDEL_RETRIEVAL_MAX_ANSWER_CLAIMS=8
OTDEL_RETRIEVAL_MAX_ANSWER_CHARS=1500
OTDEL_RETRIEVAL_CHUNK_MAX_CHARS=2000

# Note: the prose answer uses the phase 1C model adapter above (OTDEL_LLM_*). There is no
# second key for it, and configuring one does not change what gets published — a model may
# only *lower* a verdict the deterministic checker already reached, never raise one.

# --- updates and history retention, phase 1F ------------------------------------------
# Nothing here is required either, and the default is to **keep everything**. A pilot that
# started deleting its own history because a default said ninety days is a pilot whose
# first incident has no evidence, so retention is something you switch on.
#
# What a sweep may remove: entries of the event log, and jobs that have finished. What it
# may never remove, whatever these values say: published knowledge versions and their
# snapshots — including superseded and retracted ones — the stored originals and their
# pages, jobs that are still queued or running, and the record of the sweep itself.
# That list is enforced by the database, not by these settings.
#
# Both horizons are in whole days and the database refuses anything below 1: a policy that
# removes what happened today is not a retention policy. Leave both unset to keep
# everything.
# OTDEL_RETENTION_EVENT_DAYS=90
# The queue may not be pruned sooner than the log that records what its jobs did, so this
# must not exceed OTDEL_RETENTION_EVENT_DAYS, and it cannot be set without it. The server
# refuses to start otherwise rather than discovering it at the first sweep.
# OTDEL_RETENTION_JOB_DAYS=30
# The most recent finished jobs of each kind that survive regardless of age, so a partner
# processed months ago still shows a processing history.
OTDEL_RETENTION_KEEP_PER_KIND=20
# How often the maintenance pass may sweep. Minimum 300.
OTDEL_RETENTION_SWEEP_INTERVAL_SECONDS=3600

# --- logging -------------------------------------------------------------------------
# Secrets and passwords are never logged; SQL statement logging is disabled.
OTDEL_LOG=info,otdel_api=info,otdel_worker=info,sqlx=warn

# --- integration tests (see docs/backend-1a.md) --------------------------------------
# OTDEL_TEST_DATABASE_URL=
# OTDEL_TEST_ADMIN_DATABASE_URL=
# OTDEL_TEST_SUPERUSER_URL=

# --- later phases ---------------------------------------------------------------------
# S3 credentials belong to a later phase and are introduced together with the adapter that
# needs them, not before. The model key and the search key above are the only external
# credentials this system can use, and everything up to and including the product draft
# works without either.
